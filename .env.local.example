# Firebase Web App configuration
# Get these values from: Firebase Console → Project settings (gear icon)
#   → "Your apps" → select the Web app (</>) → "SDK setup and configuration".
# Copy this file to ".env.local" and replace the placeholders with your real values.
# IMPORTANT: NEXT_PUBLIC_* vars are exposed to the browser; never put secrets here.

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# Optional — only required if you enable Google Analytics in Firebase.
# Leave blank if unused; it is NOT one of the mandatory keys.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
